{
  "name": "skills",
  "version": "1.0.0",
  "description": "Skills that run inside your coding agent. Install one with `npx`, then ask the agent to run it. They work with Claude Code, Codex, Cursor, Copilot, Gemini CLI, and OpenCode.",
  "main": "index.js",
  "scripts": {
    "format": "node scripts/format.cjs",
    "format:check": "node scripts/format.cjs --check",
    "test:autopsy": "node skills/quality/autopsy/scripts/generate-report.cjs --self-check",
    "test:noexec-python": "python3 skills/languages/noexec-python/scripts/self-check.py",
    "test:noexec-rust": "bash skills/languages/noexec-rust/scripts/self-check.sh",
    "test:flake-loop": "bash skills/languages/rust-flaky-test-investigator/scripts/flake-loop.sh --self-check",
    "test:python-subprocess-concurrency": "python3 skills/languages/python-subprocess-and-concurrency/scripts/verify-recipes.py",
    "check:rust-skill-commands": "node scripts/verify-rust-skill-commands.cjs",
    "check:humanizer": "node scripts/sync-humanizer.cjs",
    "check:humanizer:live": "node scripts/sync-humanizer.cjs --live",
    "sync:humanizer": "node scripts/sync-humanizer.cjs --write",
    "update:humanizer": "node scripts/sync-humanizer.cjs --update",
    "test:plain-ssr": "node scripts/test-plain-ssr.cjs",
    "test": "node --test 'tests/**/*.test.mts'",
    "ci": "npm run format:check && npm test && npm run test:plain-ssr",
    "prepare": "node scripts/install-hooks.cjs"
  },
  "bin": {
    "pb": "./scripts/prompt-builder.cjs",
    "sqlm": "./scripts/sqlm.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentmemoir/skills.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22.18"
  },
  "bugs": {
    "url": "https://github.com/agentmemoir/skills/issues"
  },
  "homepage": "https://github.com/agentmemoir/skills#readme",
  "devDependencies": {
    "@types/node": "^22.20.5"
  }
}
