{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmemoir.dev/schemas/dependency-decisions.schema.json",
  "title": "DependencyDecisions",
  "description": "Machine-readable record of dependency findings and decisions from a Modernizer session. One file per audit, written outside the audited repository.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "date",
    "repository",
    "distribution_model",
    "scope",
    "summary",
    "decisions"
  ],
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date the decisions were recorded, YYYY-MM-DD."
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "description": "Repository identity, as owner/name or a local path."
    },
    "audit_report": {
      "type": "string",
      "minLength": 1,
      "description": "Path to the Level 1 audit report these decisions follow."
    },
    "distribution_model": {
      "$ref": "#/$defs/distributionModel"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "decisions": {
      "type": "array",
      "description": "One entry per dependency finding, or one entry per approved batch of like findings.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/dependencyDecision"
          },
          {
            "$ref": "#/$defs/groupDecision"
          }
        ]
      }
    },
    "accepted_risks": {
      "type": "array",
      "description": "Risks I accepted, with the record needed to review them later.",
      "items": {
        "$ref": "#/$defs/acceptedRisk"
      }
    },
    "gaps": {
      "type": "array",
      "description": "Surfaces, versions, or licences that could not be verified.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "distributionModel": {
      "type": "string",
      "description": "How the software reaches people. Unknown is allowed, but it blocks an unqualified migration recommendation.",
      "enum": [
        "proprietary-binary",
        "hosted-service",
        "internal-only",
        "open-source",
        "mobile-embedded",
        "container-image",
        "sdk-library",
        "mixed",
        "unknown"
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "Version exactly as the ecosystem writes it, including any epoch, revision, or distro suffix."
    },
    "priority": {
      "type": "string",
      "enum": [
        "Critical",
        "High",
        "Medium",
        "Low"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "effort": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "unknown"
      ]
    },
    "recommendation": {
      "type": "string",
      "description": "A upgrade, B replace, C migrate away, D retain.",
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ]
    },
    "decision": {
      "type": "string",
      "description": "What I chose. It may differ from the recommendation.",
      "enum": [
        "upgrade",
        "replace",
        "migrate",
        "retain",
        "remove",
        "defer",
        "pending"
      ]
    },
    "status": {
      "type": "string",
      "description": "Approved requires my explicit answer to that exact decision.",
      "enum": [
        "approved",
        "rejected",
        "deferred",
        "pending",
        "blocked"
      ]
    },
    "surface": {
      "type": "string",
      "enum": [
        "package",
        "os",
        "container",
        "ci",
        "iac",
        "vendored",
        "binary",
        "asset",
        "other"
      ]
    },
    "licenceRisk": {
      "type": "string",
      "enum": [
        "none",
        "low",
        "high",
        "blocked",
        "legal-review",
        "unknown"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "checked"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "Advisory database, upstream release note, licence file, or registry entry."
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "checked": {
          "type": "string",
          "format": "date",
          "description": "Date this source was checked, YYYY-MM-DD."
        },
        "note": {
          "type": "string"
        }
      }
    },
    "licence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current",
        "risk"
      ],
      "properties": {
        "current": {
          "type": "string",
          "minLength": 1,
          "description": "Licence of the installed version, as verified in the licence file."
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "description": "Licence of the proposed version or replacement."
        },
        "risk": {
          "$ref": "#/$defs/licenceRisk"
        },
        "obligations": {
          "type": "array",
          "description": "Obligations that bind for this distribution model, stated plainly.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "dependencyDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "package",
        "ecosystem",
        "surface",
        "directness",
        "installed_version",
        "recommendation",
        "decision",
        "priority",
        "confidence",
        "status",
        "rationale"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Finding ID from the audit report."
        },
        "package": {
          "type": "string",
          "minLength": 1
        },
        "ecosystem": {
          "type": "string",
          "minLength": 1,
          "description": "Package manager or platform, for example cargo, npm, pypi, apt, oci."
        },
        "surface": {
          "$ref": "#/$defs/surface"
        },
        "directness": {
          "type": "string",
          "enum": [
            "direct",
            "transitive",
            "unknown"
          ]
        },
        "dependency_type": {
          "type": "string",
          "enum": [
            "production",
            "development",
            "build",
            "peer",
            "optional",
            "system",
            "other"
          ]
        },
        "installed_version": {
          "$ref": "#/$defs/version"
        },
        "latest_version": {
          "$ref": "#/$defs/version"
        },
        "target_version": {
          "$ref": "#/$defs/version"
        },
        "replacement": {
          "type": "string",
          "minLength": 1,
          "description": "Package that replaces this one, for recommendation B or C."
        },
        "recommendation": {
          "$ref": "#/$defs/recommendation"
        },
        "decision": {
          "$ref": "#/$defs/decision"
        },
        "priority": {
          "$ref": "#/$defs/priority"
        },
        "effort": {
          "$ref": "#/$defs/effort"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "description": "Why this decision holds, in plain English."
        },
        "licence": {
          "$ref": "#/$defs/licence"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "review_trigger": {
          "type": "string",
          "minLength": 1,
          "description": "What reopens this decision: an EOL date, advisory, major release, or support change."
        }
      }
    },
    "groupDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "members",
        "recommendation",
        "decision",
        "status",
        "rationale"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "members": {
          "type": "array",
          "description": "Finding IDs in this batch.",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "recommendation": {
          "$ref": "#/$defs/recommendation"
        },
        "decision": {
          "$ref": "#/$defs/decision"
        },
        "priority": {
          "$ref": "#/$defs/priority"
        },
        "effort": {
          "$ref": "#/$defs/effort"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "acceptedRisk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "owner",
        "mitigation",
        "review_date"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "description": "Accountable person, not a team alias, unless no person is known."
        },
        "mitigation": {
          "type": "string",
          "minLength": 1
        },
        "review_date": {
          "type": "string",
          "format": "date"
        },
        "expiry_date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ecosystems",
        "surfaces_inspected",
        "surfaces_not_inspected"
      ],
      "properties": {
        "ecosystems": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "surfaces_inspected": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "surfaces_not_inspected": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "direct_dependencies": {
          "type": "integer",
          "minimum": 0
        },
        "resolved_dependencies": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_findings",
        "by_priority",
        "by_recommendation",
        "licence_blocked"
      ],
      "properties": {
        "total_findings": {
          "type": "integer",
          "minimum": 0
        },
        "by_priority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "Critical",
            "High",
            "Medium",
            "Low"
          ],
          "properties": {
            "Critical": {
              "type": "integer",
              "minimum": 0
            },
            "High": {
              "type": "integer",
              "minimum": 0
            },
            "Medium": {
              "type": "integer",
              "minimum": 0
            },
            "Low": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "by_recommendation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "A",
            "B",
            "C",
            "D"
          ],
          "properties": {
            "A": {
              "type": "integer",
              "minimum": 0
            },
            "B": {
              "type": "integer",
              "minimum": 0
            },
            "C": {
              "type": "integer",
              "minimum": 0
            },
            "D": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "licence_blocked": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
